# The Missing Piece - Environment Configuration
# Copy this file to .env and adjust values

# Server Configuration
HOST=0.0.0.0
PORT=8080

# Environment
NODE_ENV=production

# Data Storage
DATA_DIR=../data

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin (optional - set to enable admin features)
# ADMIN_TOKEN=your-secure-token-here

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
